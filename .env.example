# Copie para .env e ajuste:  cp .env.example .env
# (.env NUNCA vai para o git — já está no .gitignore)

# mock  = MockLLMClient em processo (sem rede)
# real  = RealLLMClient via HTTP (usa LLM_BASE_URL abaixo)
LLM_MODE=real

# Padrão: o mock OpenAI-compatível do docker-compose.
# Para provedor real: https://api.openai.com/v1 (e preencha LLM_API_KEY)
LLM_BASE_URL=http://llm-mock:8001/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30

# memory = em processo (perde no restart, 1 worker)
# redis  = persistente (compose sobe o serviço redis)
STORAGE=redis
REDIS_URL=redis://redis:6379/0
